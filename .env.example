AMAP_KEY=your_amap_web_service_key

# QWeather: choose API Key or JWT. QWEATHER_API_KEY is preferred;
# HEFENG_KEY remains supported as a compatibility alias.
QWEATHER_API_KEY=your_qweather_api_key
# HEFENG_KEY=your_qweather_api_key

# JWT alternative (set all fields and use your custom API Host):
# QWEATHER_KID=your_credential_id
# QWEATHER_PROJECT_ID=your_project_id
# QWEATHER_PRIVATE_KEY=C:/path/to/ed25519-private.pem
# QWEATHER_BASE_URL=https://your-host.qweatherapi.com
# Optional override. For a custom API Host, /geo/v2 is derived automatically.
# QWEATHER_GEO_URL=https://your-host.qweatherapi.com/geo/v2
# QWEATHER_JWT_TTL_SECONDS=900

# Caiyun official name is preferred; CAIYUN_KEY remains supported as an alias.
CAIYUN_WEATHER_API_TOKEN=your_caiyun_api_key
# CAIYUN_KEY=your_caiyun_api_key

# Optional request timeout in milliseconds. Default: 5000.
WEATHER_TIMEOUT_MS=5000

# Optional: set to 1 to bypass all in-process weather caches.
# WEATHER_CACHE_DISABLED=0

# Optional persistent cache. If omitted, cache remains memory-only.
# Use a private writable path; GeoAPI results are never cached.
# WEATHER_CACHE_FILE=C:/OpenClaw/data/dual-weather-cache.json

# Optional provider circuit breaker. Defaults: 3 failures, 60-second cooldown.
# WEATHER_CIRCUIT_FAILURES=3
# WEATHER_CIRCUIT_COOLDOWN_MS=60000
