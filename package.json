{
  "name": "openclaw-dual-weather",
  "version": "0.8.0",
  "description": "Give OpenClaw concise, cross-checked weather answers from QWeather and Caiyun, with professional details on demand.",
  "type": "module",
  "main": "./index.ts",
  "files": [
    ".env.example",
    "index.ts",
    "src",
    "scripts",
    "skills",
    "openclaw.plugin.json"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "setup:caiyun-mcp": "node scripts/setup-caiyun-mcp.mjs"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.52"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2"
  },
  "peerDependencies": {
    "openclaw": ">=2026.3.24"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "compat": {
      "pluginApi": ">=2026.3.24",
      "minGatewayVersion": "2026.3.24"
    },
    "build": {
      "openclawVersion": "2026.4.9",
      "pluginSdkVersion": "2026.4.9"
    }
  },
  "engines": {
    "node": ">=22.14.0"
  }
}
